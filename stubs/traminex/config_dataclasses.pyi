from dataclasses import dataclass
from dataclasses import field as field
from typing import Sequence

import numpy as np

@dataclass
class TRATEConfig:
    smoothing: float = ...
    mode: str = ...
    normalize: str = ...
    weights: np.ndarray | None = ...
    def as_dict(self) -> dict: ...
    def __post_init__(self) -> None: ...

@dataclass
class DHDConfig:
    variant: str | None = ...
    smooth_window: int | None = ...
    profile: str = ...
    def as_dict(self) -> dict: ...
    def __post_init__(self) -> None: ...

@dataclass
class OMConfig:
    indel: float | Sequence[float] | np.ndarray | str = ...
    subm: float | np.ndarray | str = ...
    norm: str | None = ...
    indel_by_pos: np.ndarray | None = ...
    subm_by_pos: np.ndarray | None = ...
    trate_config: TRATEConfig | None = ...
    def as_dict(self) -> dict: ...
    def __post_init__(self) -> None: ...

@dataclass
class LCSLCPConfig:
    norm: str | None = ...
    def as_dict(self) -> dict: ...
    def __post_init__(self) -> None: ...

@dataclass
class DURConfig:
    metric: str = ...
    def as_dict(self) -> dict: ...
    def __post_init__(self) -> None: ...

def default_configs() -> dict: ...
