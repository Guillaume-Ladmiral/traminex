from dataclasses import dataclass
from typing import Literal

import numpy as np

from .events import SeqElist

@dataclass
class STSList:
    data: np.ndarray
    alphabet: list[str]
    labels: list[str] | None = ...
    cpal: list[str] | None = ...
    xtlab: list[str] | None = ...
    xtstep: int = ...
    tick_last: bool = ...
    nr: str = ...
    void: str = ...
    nr_code: int | None = ...
    void_code: int | None = ...
    weights: np.ndarray | None = ...
    start: int = ...
    ids: list[object] | None = ...
    missing_color: str = ...
    issues: dict[str, list[int]] | None = ...
    def __post_init__(self) -> None: ...
    @property
    def nseq(self) -> int: ...
    @property
    def seqlen(self) -> int: ...
    def copy(self) -> STSList: ...
    def to_strings(self, sep: str = "-") -> list[str]: ...

def alphabet(x: STSList | SeqElist, with_missing: bool = False) -> list[str]: ...
def cpal(x: STSList) -> list[str] | None: ...
def stlab(x: STSList) -> list[str]: ...
def seqgen_missing(
    x: STSList,
    *,
    p_cases: float = 0.1,
    p_left: float = 0.2,
    p_gaps: float = 0.0,
    p_right: float = 0.3,
    mt_left: Literal["nr", "void"] = "nr",
    mt_gaps: Literal["nr", "void"] = "nr",
    mt_right: Literal["nr", "void"] = "nr",
    random_state: int | np.random.Generator | None = None,
) -> STSList: ...
@dataclass
class SeqMD:
    channels: list[STSList]
    names: list[str] | None = ...

def seqMD_distances(
    obj: SeqMD,
    *,
    method: str = "LCS",
    weights: list[float] | None = None,
    per_channel_kwargs: list[dict] | None = None,
) -> np.ndarray: ...
